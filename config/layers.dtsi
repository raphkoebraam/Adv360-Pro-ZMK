// Layer defines for sunaku-style Miryoku layout
// Translated from sunaku/glove80-keymaps v52 "Glorious Engrammer"

// Operating system
#define OPERATING_SYSTEM 'M' // macOS

// macOS key abstractions
#define _C      LG
#define _A_TAB  LGUI
#define _G_TAB  LALT
#define _REDO   LG(LS(Z))
#define _POWER  K_POWER
#define _WORD   LA
#define _HOME   LG(LEFT)
#define _END    LG(RIGHT)
#define _EMOJI  LG(LC(SPACE))
#define _LOCK   _C(LC(Q))
#define _UNDO   _C(Z)
#define _CUT    _C(X)
#define _COPY   _C(C)
#define _PASTE  _C(V)
#define _FIND       _C(F)
#define _FIND_NEXT  _C(G)
#define _FIND_PREV  _C(LS(G))
#define _FILES      LS(LA(M))
#define _SLEEP      C_SLEEP

// Select word/line delay
#define SELECT_WORD_DELAY 1

// Layer ordering — compact for now, expand as phases are implemented
//
// Phase 2 core layers:
#define LAYER_QWERTY      0   // default base layer (kept)
#define LAYER_Cursor      1   // arrows, navigation (replaces keypad)
#define LAYER_Number      2   // numpad, hex (replaces fn)
#define LAYER_Mod         3   // BT, bootloader, RGB (kept as-is)
#define LAYER_Symbol      4   // programming symbols (replaces nav_symbol)
#define LAYER_Function    5   // F-keys, media (new)
#define LAYER_System      6   // system controls (new)
#define LAYER_Lower       7   // layer toggles, sticky mods (new)
//
// Future phases (uncomment and renumber as implemented):
