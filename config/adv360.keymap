#include <dt-bindings/zmk/stp.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include "layers.dtsi"

#define MOUSE_LAYER_SLOW 6
#define MOUSE_LAYER_FAST 7
#define MOUSE_LAYER_WARP 8

&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};

// Mouse movement speed scaling per layer

&mmv_input_listener {
    slow {
        layers = <MOUSE_LAYER_SLOW>;
        input-processors = <&zip_xy_scaler 1 12>;
    };

    fast {
        layers = <MOUSE_LAYER_FAST>;
        input-processors = <&zip_xy_scaler 4 1>;
    };

    warp {
        layers = <MOUSE_LAYER_WARP>;
        input-processors = <&zip_xy_scaler 12 1>;
    };
};

// Mouse scroll speed scaling per layer

/ {
    input_processors {
        zip_scroll_scaler: zip_scroll_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    slow {
        layers = <MOUSE_LAYER_SLOW>;
        input-processors = <&zip_scroll_scaler 1 9>;
    };

    fast {
        layers = <MOUSE_LAYER_FAST>;
        input-processors = <&zip_scroll_scaler 3 1>;
    };

    warp {
        layers = <MOUSE_LAYER_WARP>;
        input-processors = <&zip_scroll_scaler 9 1>;
    };
};

&caps_word {
    continue-list = <
        UNDERSCORE MINUS KP_MINUS
        BACKSPACE DELETE
        LEFT_SHIFT RIGHT_SHIFT
        N1 N2 N3 N4 N5 N6 N7 N8 N9 N0
        KP_N1 KP_N2 KP_N3 KP_N4 KP_N5 KP_N6 KP_N7 KP_N8 KP_N9 KP_N0
    >;
};

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        // Per-finger home row mods — left hand
        // Hold triggers on right-hand + thumb keys

        left_pinky: homey_left_pinky {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = HOMEY_HOLDING_TYPE;
            tapping-term-ms = <PINKY_HOLDING_TIME>;
            quick-tap-ms = <HOMEY_REPEAT_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS THUMB_KEYS>;
        };

        left_ringy: homey_left_ringy {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = HOMEY_HOLDING_TYPE;
            tapping-term-ms = <RINGY_HOLDING_TIME>;
            quick-tap-ms = <HOMEY_REPEAT_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS THUMB_KEYS>;
        };

        left_middy: homey_left_middy {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = HOMEY_HOLDING_TYPE;
            tapping-term-ms = <MIDDY_HOLDING_TIME>;
            quick-tap-ms = <HOMEY_REPEAT_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS THUMB_KEYS>;
        };

        left_index: homey_left_index {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = HOMEY_HOLDING_TYPE;
            tapping-term-ms = <INDEX_HOLDING_TIME>;
            quick-tap-ms = <HOMEY_REPEAT_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS THUMB_KEYS>;
        };

        // Per-finger home row mods — right hand
        // Hold triggers on left-hand + thumb keys

        right_pinky: homey_right_pinky {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = HOMEY_HOLDING_TYPE;
            tapping-term-ms = <PINKY_HOLDING_TIME>;
            quick-tap-ms = <HOMEY_REPEAT_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <LEFT_HAND_KEYS THUMB_KEYS>;
        };

        right_ringy: homey_right_ringy {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = HOMEY_HOLDING_TYPE;
            tapping-term-ms = <RINGY_HOLDING_TIME>;
            quick-tap-ms = <HOMEY_REPEAT_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <LEFT_HAND_KEYS THUMB_KEYS>;
        };

        right_middy: homey_right_middy {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = HOMEY_HOLDING_TYPE;
            tapping-term-ms = <MIDDY_HOLDING_TIME>;
            quick-tap-ms = <HOMEY_REPEAT_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <LEFT_HAND_KEYS THUMB_KEYS>;
        };

        right_index: homey_right_index {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = HOMEY_HOLDING_TYPE;
            tapping-term-ms = <INDEX_HOLDING_TIME>;
            quick-tap-ms = <HOMEY_REPEAT_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <LEFT_HAND_KEYS THUMB_KEYS>;
        };

        // Bilateral enforcement hold-tap behaviors
        // Same timing as standard per-finger behaviors, but hold action
        // uses _hold macro (press mod + activate bilateral layer)

        left_pinky_bilateral: homey_left_pinky_bilateral {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&left_pinky_hold>, <&kp>;
            flavor = HOMEY_HOLDING_TYPE;
            tapping-term-ms = <PINKY_HOLDING_TIME>;
            quick-tap-ms = <HOMEY_REPEAT_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS THUMB_KEYS>;
        };

        left_ringy_bilateral: homey_left_ringy_bilateral {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&left_ringy_hold>, <&kp>;
            flavor = HOMEY_HOLDING_TYPE;
            tapping-term-ms = <RINGY_HOLDING_TIME>;
            quick-tap-ms = <HOMEY_REPEAT_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS THUMB_KEYS>;
        };

        left_middy_bilateral: homey_left_middy_bilateral {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&left_middy_hold>, <&kp>;
            flavor = HOMEY_HOLDING_TYPE;
            tapping-term-ms = <MIDDY_HOLDING_TIME>;
            quick-tap-ms = <HOMEY_REPEAT_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS THUMB_KEYS>;
        };

        left_index_bilateral: homey_left_index_bilateral {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&left_index_hold>, <&kp>;
            flavor = HOMEY_HOLDING_TYPE;
            tapping-term-ms = <INDEX_HOLDING_TIME>;
            quick-tap-ms = <HOMEY_REPEAT_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS THUMB_KEYS>;
        };

        right_index_bilateral: homey_right_index_bilateral {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&right_index_hold>, <&kp>;
            flavor = HOMEY_HOLDING_TYPE;
            tapping-term-ms = <INDEX_HOLDING_TIME>;
            quick-tap-ms = <HOMEY_REPEAT_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <LEFT_HAND_KEYS THUMB_KEYS>;
        };

        right_middy_bilateral: homey_right_middy_bilateral {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&right_middy_hold>, <&kp>;
            flavor = HOMEY_HOLDING_TYPE;
            tapping-term-ms = <MIDDY_HOLDING_TIME>;
            quick-tap-ms = <HOMEY_REPEAT_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <LEFT_HAND_KEYS THUMB_KEYS>;
        };

        right_ringy_bilateral: homey_right_ringy_bilateral {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&right_ringy_hold>, <&kp>;
            flavor = HOMEY_HOLDING_TYPE;
            tapping-term-ms = <RINGY_HOLDING_TIME>;
            quick-tap-ms = <HOMEY_REPEAT_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <LEFT_HAND_KEYS THUMB_KEYS>;
        };

        right_pinky_bilateral: homey_right_pinky_bilateral {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&right_pinky_hold>, <&kp>;
            flavor = HOMEY_HOLDING_TYPE;
            tapping-term-ms = <PINKY_HOLDING_TIME>;
            quick-tap-ms = <HOMEY_REPEAT_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <LEFT_HAND_KEYS THUMB_KEYS>;
        };

        // Thumb cluster layer-tap
        thumb: thumb_layer_access {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = THUMB_HOLDING_TYPE;
            tapping-term-ms = <THUMB_HOLDING_TIME>;
            quick-tap-ms = <THUMB_REPEAT_DECAY>;
        };

        // Sticky key one-shot (used in combos for sticky shift)
        sticky_key_modtap: sticky_key_modtap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&sticky_key_oneshot>;
            flavor = "tap-preferred";
            tapping-term-ms = <STICKY_HOLDING_TIME>;
        };
        sticky_key_oneshot: sticky_key_oneshot_macro {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings
              = <&macro_param_1to1>
              , <&macro_tap &sticky_key_quickrel MACRO_PLACEHOLDER>
              ;
        };
        sticky_key_quickrel: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <STICKY_1SHOT_DECAY>;
            quick-release;
            ignore-modifiers;
        };

        key_lh_t2: key_lh_t2 {
            compatible = "zmk,behavior-mod-morph";
            label = "KEY_LH_T2";
            bindings = <&kp LS(N3)>, <&kp LG(LS(N4))>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        key_rh_t2: key_rh_t2 {
            compatible = "zmk,behavior-mod-morph";
            label = "KEY_RH_T2";
            bindings = <&kp LS(N6)>, <&kp LG(LS(N5))>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
    };

    combos {
        compatible = "zmk,combos";

        combo_caps_word {
            bindings = <&caps_word>;
            key-positions = <32 41>;
            timeout-ms = <COMBO_FIRING_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
        };

        combo_caps_lock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <50 55>;
            timeout-ms = <COMBO_FIRING_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
        };

        // Row above home combos — left hand (Q=15, W=16, E=17, R=18)

        lh_combo_cut {
            bindings = <&kp _CUT>;
            key-positions = <15 16>;
            timeout-ms = <COMBO_FIRING_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
        };

        lh_combo_copy {
            bindings = <&kp _COPY>;
            key-positions = <16 17>;
            timeout-ms = <COMBO_FIRING_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
        };

        lh_combo_paste {
            bindings = <&kp _PASTE>;
            key-positions = <17 18>;
            timeout-ms = <COMBO_FIRING_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
        };

        lh_combo_undo {
            bindings = <&kp _UNDO>;
            key-positions = <16 18>;
            timeout-ms = <COMBO_FIRING_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
        };

        lh_combo_redo {
            bindings = <&kp _REDO>;
            key-positions = <15 17>;
            timeout-ms = <COMBO_FIRING_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
        };

        lh_combo_select_all {
            bindings = <&kp _C(A)>;
            key-positions = <15 18>;
            timeout-ms = <COMBO_FIRING_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
        };

        // Row above home combos — right hand mirrored (U=23, I=24, O=25, P=26)

        rh_combo_cut {
            bindings = <&kp _CUT>;
            key-positions = <25 26>;
            timeout-ms = <COMBO_FIRING_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
        };

        rh_combo_copy {
            bindings = <&kp _COPY>;
            key-positions = <24 25>;
            timeout-ms = <COMBO_FIRING_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
        };

        rh_combo_paste {
            bindings = <&kp _PASTE>;
            key-positions = <23 24>;
            timeout-ms = <COMBO_FIRING_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
        };

        rh_combo_undo {
            bindings = <&kp _UNDO>;
            key-positions = <23 25>;
            timeout-ms = <COMBO_FIRING_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
        };

        rh_combo_redo {
            bindings = <&kp _REDO>;
            key-positions = <24 26>;
            timeout-ms = <COMBO_FIRING_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
        };

        rh_combo_select_all {
            bindings = <&kp _C(A)>;
            key-positions = <23 26>;
            timeout-ms = <COMBO_FIRING_DECAY>;
            require-prior-idle-ms = <HOMEY_STREAK_DECAY>;
        };

        // =====================================================================
        // Sunaku-style thumb combos
        // =====================================================================

        // T1+T2: sticky AltGr (left hand only — no RH_T2)
        combo_sticky_altgr_left {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <POS_LH_T1 POS_LH_T2>;
            bindings = <&sk RALT>;
        };

        // T1+T4: Alt-Tab application switcher (left hand)
        combo_alt_tab_switcher_left {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <POS_LH_T1 POS_LH_T4>;
            bindings = <&mod_tab_chord _A_TAB LAYER_Cursor>;
        };

        // T1+T4: Hyper (right hand)
        combo_hyper_right {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <POS_RH_T1 POS_RH_T4>;
            bindings = <&kp LG(LA(LC(LSHFT)))>;
        };

        // T2+T5: Ctrl-Tab switcher (left hand only — no RH_T2)
        combo_ctrl_tab_switcher_left {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <POS_LH_T2 POS_LH_T5>;
            bindings = <&mod_tab_chord LCTL LAYER_Cursor>;
        };

        // T1+T5: Sticky shift
        combo_sticky_shift_left {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <POS_LH_T1 POS_LH_T5>;
            bindings = <&sticky_key_modtap LSFT LSFT>;
        };

        combo_sticky_shift_right {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <POS_RH_T1 POS_RH_T5>;
            bindings = <&sticky_key_modtap RSFT RSFT>;
        };

        // T4+T5: Caps word (thumb version — complements F+J combo)
        combo_caps_word_left_thumb {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <POS_LH_T4 POS_LH_T5>;
            bindings = <&caps_word>;
        };

        combo_caps_word_right_thumb {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <POS_RH_T4 POS_RH_T5>;
            bindings = <&caps_word>;
        };

        // T2+T6: Caps lock (left hand only — no RH_T2)
        combo_caps_lock_left_thumb {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <POS_LH_T2 POS_LH_T6>;
            bindings = <&kp CAPSLOCK>;
        };

        // T1+T2+T4: Base layer reset (3-key chord for safety)
        combo_base_layer_reset_left {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <POS_LH_T1 POS_LH_T2 POS_LH_T4>;
            bindings = <&to 0>;
        };

        combo_base_layer_reset_right {
            timeout-ms = <COMBO_FIRING_DECAY>;
            key-positions = <POS_RH_T1 POS_RH_T4 POS_RH_T5>;
            bindings = <&to 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp EQUAL   &kp NUMBER_1                      &kp NUMBER_2                    &kp NUMBER_3                    &kp NUMBER_4                       &kp NUMBER_5  &none                                                                                                                                        &mo LAYER_Mod    &kp NUMBER_6  &kp NUMBER_7                       &kp NUMBER_8                    &kp NUMBER_9                    &kp NUMBER_0                      &kp MINUS
&kp LS(N2)  &kp Q                             &kp W                           &kp E                           &kp R                              &kp T         &kp LG(LS(N3))                                                                                                                   &kp LG(LS(N5))  &kp Y         &kp U                              &kp I                           &kp O                           &kp P                             &kp BSLH
&kp ESCAPE  &kp A                             &kp S                           &kp D                           &left_index LS(LA(LC(LGUI))) F     &kp G         &kp LG(LS(N4))  &kp GRAVE  &key_lh_t2                                    &kp EQUAL                    &key_rh_t2     &kp LC(LG(Q))   &kp H         &right_index LS(LA(LC(LGUI))) J    &kp K                           &kp L                           &kp SEMI                          &kp SQT
&kp LSHFT   &HRM_LEFT_PINKY(Z)                &HRM_LEFT_RINGY(X)              &HRM_LEFT_MIDDY(C)              &HRM_LEFT_INDEX(V)                 &kp B                                    &thumb LAYER_Function ESC &thumb LAYER_Lower DELETE                                       &kp N         &HRM_RIGHT_INDEX(M)                &HRM_RIGHT_MIDDY(COMMA)         &HRM_RIGHT_RINGY(DOT)           &HRM_RIGHT_PINKY(FSLH)            &kp RSHFT
&mo LAYER_Mod &kp END                         &kp PAGE_UP                     &kp PAGE_DOWN                   &kp HOME                                         &thumb LAYER_Cursor RETURN  &thumb LAYER_Number TAB  &kp BACKSPACE  &thumb LAYER_System RETURN  &kp BACKSPACE  &thumb LAYER_Symbol SPACE                   &kp LEFT                           &kp DOWN                        &kp UP                          &kp RIGHT                         &mo LAYER_Mod
            >;
        };

        layer_Cursor {
            bindings = <
&none      &kp ESC             &kp INS             &kp LS(TAB)         &kp DEL              &none          &trans                                                                                    &trans          &none          &none              &none              &none          &none              &none
&none      &kp RET             &kp SPACE            &kp TAB             &kp BSPC             &kp _CUT       &trans                                                                                    &trans          &kp _CUT       &kp LS(TAB)        &kp _UNDO          &kp _REDO      &kp TAB            &none
&sk LSHFT  &kp LEFT_PINKY_MOD  &kp LEFT_RINGY_MOD   &kp LEFT_MIDDY_MOD  &kp LEFT_INDEX_MOD   &kp _COPY      &trans     &none          &none                     &extend_line       &extend_word  &trans          &kp _COPY      &kp LEFT           &kp UP             &kp DOWN       &kp RIGHT          &sk LSHFT
&kp _C(L)  &select_all         &select_line         &select_word        &kp _FIND            &kp _PASTE                &none          &select_none                                                    &kp _PASTE     &kp _HOME          &kp PG_UP          &kp PG_DN      &kp _END           &kp _C(L)
&kp _C(K)  &kp _UNDO           &kp _REDO            &kp _FIND_PREV      &kp _FIND_NEXT                      &tog LAYER_Cursor  &none  &none                     &select_all        &select_line  &select_word                   &kp _FIND          &kp _FIND_PREV     &kp _FIND_NEXT &kp _C(H)          &kp _C(K)
            >;
        };

        layer_Number {
            bindings = <
&none      &kp ESC             &kp INS             &kp LS(TAB)         &kp DEL              &none          &trans                                                                                    &trans          &kp LS(BSLH)   &kp LS(N3)         &kp LS(N4)         &kp LS(N6)     &kp LS(GRAVE)      &kp LS(N1)
&none      &kp RET             &kp SPACE            &kp TAB             &kp BSPC             &kp N0         &trans                                                                                    &trans          &kp LS(G)      &kp N7             &kp N8             &kp N9         &kp LS(SEMI)       &kp LS(N5)
