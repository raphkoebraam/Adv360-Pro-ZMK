        // =====================================================================
        // Bilateral enforcement layers (8 layers, one per finger)
        //
        // How it works:
        // - Hold a home row mod key (e.g., Z = Ctrl on left pinky)
        // - The _hold macro presses Ctrl AND activates this layer
        // - Same-hand keys: _tap macro releases Ctrl, types the held key (Z)
        //   then types the tapped key — cancelling the modifier
        // - Opposite-hand keys: &trans — Ctrl passes through normally
        // - Result: only cross-hand modifier combos work
        // =====================================================================

        layer_LeftPinky {
            bindings = <
&left_pinky_tap EQUAL   &left_pinky_tap N1      &left_pinky_tap N2      &left_pinky_tap N3      &left_pinky_tap N4      &left_pinky_tap N5  &trans                                                                                                                          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&left_pinky_tap LS(N2)  &left_pinky_tap Q       &left_pinky_tap W       &left_pinky_tap E       &left_pinky_tap R       &left_pinky_tap T   &trans                                                                                                                          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&left_pinky_tap ESC     &left_pinky_tap A       &left_pinky_tap S       &left_pinky_tap D       &left_pinky_tap F       &left_pinky_tap G   &trans  &trans  &trans                                              &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans                  &none                   &left_pinky_tap X       &left_pinky_tap C       &left_pinky_tap V       &left_pinky_tap B           &trans  &trans                                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans                  &left_pinky_tap END     &left_pinky_tap PG_UP   &left_pinky_tap PG_DN   &left_pinky_tap HOME                        &trans  &trans  &trans                                              &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

